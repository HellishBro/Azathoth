{
  "compilerOptions": {
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "lib": [
        "ESNext"
    ],
    "types": [
        "@types/node"
    ],
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/*"]
}